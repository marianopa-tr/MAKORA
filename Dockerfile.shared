# ── Makora Shared App (Single Image) ──────────────────────────────────
# Builds the worker and dashboard, then serves both from one container.
#
# Build:  docker build -f Dockerfile.shared -t makora-shared-app .
# Run:    docker run -p 3000:80 --env-file .env.docker makora-shared-app
# ───────────────────────────────────────────────────────────────────────

# ── Build worker assets ────────────────────────────────────────────────
FROM node:22-slim AS worker-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json biome.json ./
COPY src/ src/
COPY migrations/ migrations/
COPY wrangler-app.jsonc ./

RUN npm run build

# ── Build dashboard assets ─────────────────────────────────────────────
FROM node:22-slim AS dashboard-builder

WORKDIR /dashboard

COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci

COPY dashboard/ ./

# Frontend calls /status, /tick, etc. at root; nginx handles proxying.
ENV VITE_APP_API_BASE=""
RUN npm run build

# ── Runtime image with worker + nginx ─────────────────────────────────
FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    nginx \
  && rm -f /etc/nginx/sites-enabled/default \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=worker-builder /app/package.json ./package.json
COPY --from=worker-builder /app/package-lock.json ./package-lock.json
COPY --from=worker-builder /app/node_modules ./node_modules
COPY --from=worker-builder /app/tsconfig.json ./tsconfig.json
COPY --from=worker-builder /app/biome.json ./biome.json
COPY --from=worker-builder /app/src ./src
COPY --from=worker-builder /app/migrations ./migrations
COPY --from=worker-builder /app/wrangler-app.jsonc ./wrangler-app.jsonc

COPY --from=dashboard-builder /dashboard/dist /usr/share/nginx/html
COPY docker/nginx.shared.conf /etc/nginx/conf.d/default.conf
COPY docker-entrypoint.shared.sh /docker-entrypoint.shared.sh
RUN chmod +x /docker-entrypoint.shared.sh

VOLUME /app/.wrangler/state

EXPOSE 80
EXPOSE 8788

ENTRYPOINT ["/docker-entrypoint.shared.sh"]
